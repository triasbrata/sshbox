# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# tools/build_apple.sh writes its packages here.
/dist/
# fvm's link to the SDK pinned in .fvmrc.
.fvm/

# The Play service account key that tool/play_publish.py signs in with. It
# belongs beside the upload keystore, outside the repo; this is in case a copy
# ever lands in the tree.
*service-account*.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# The Kotlin compiler daemon's session files, which a Gradle build leaves
# behind and a `git add -A` beside a running build would otherwise commit.
/android/.kotlin/

# Widget Preview related
.widget_preview/

# CMake's scratch for a plugin's native code, left by an Android build.
**/android/.cxx/
