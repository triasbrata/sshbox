<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is allowed, for the web tabs.

  A dev server on a host, or one forwarded to the tailnet
  (http://<host>.<tailnet>.ts.net:3001), speaks plain http, and without this
  the WebView refuses it outright (net::ERR_CLEARTEXT_NOT_PERMITTED) where a
  browser would open it. On the tailnet the bytes travel inside WireGuard
  anyway. A domain-config cannot do it instead: the hosts are whatever a
  terminal prints.

  Nothing else in the app speaks HTTP — SSH is its own socket, which this does
  not touch, and push goes through Google Play services — so this decides what
  the WebView may load and nothing more.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
