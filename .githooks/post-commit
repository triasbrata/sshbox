#!/bin/sh
# After `git commit <paths>`, git commits pre-commit's bump but keeps the index
# as it was before the commit. Bring the index's build number up to the
# commit's, or the next commit would take it back. A no-op otherwise.
set -eu

f=pubspec.yaml
git cat-file -e "HEAD:$f" 2>/dev/null && git cat-file -e ":$f" 2>/dev/null || exit 0
n=$(git show "HEAD:$f" | sed -n 's/^version:[^+]*+\([0-9][0-9]*\).*/\1/p' | head -n 1)
[ -n "$n" ] || exit 0
blob=$(git show ":$f" | sed "s/^\(version:[^+]*+\)[0-9][0-9]*/\1$n/" | git hash-object -w --stdin)
[ "$blob" = "$(git rev-parse ":$f")" ] || git update-index --cacheinfo "100644,$blob,$f"
