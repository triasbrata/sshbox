#!/bin/sh
# Tags the commit vX.Y.Z when it is the first to carry the version name X.Y.Z
# on pubspec.yaml's version line: an X.Y with no tag yet, a major or minor
# changed by hand, or the patch one past X.Y's newest tag, which
# .githooks/pre-commit raised. Any other name, such as an old 1.0.N+N line a
# merge brought back, is left untagged for pre-commit to put right. The tag is
# annotated, so `git push` takes it along with its commit (push.followTags; see
# CLAUDE.md), and pre-commit counts the patch's ten builds from the build
# number it tags.
# ponytail: amending or rebasing a tagged commit leaves its tag on the old one;
# move it by hand with git tag -f -a.
#
# Then, after `git commit <paths>`, git commits pre-commit's bump but keeps the
# index as it was before the commit. Bring the index's version line, X.Y.Z+N,
# up to the commit's, or the next commit would take it back. A no-op when the
# index already has the commit's N, so a line not yet bumped waits for its next
# bump instead of turning up as a staged change.
set -eu

f=pubspec.yaml
git cat-file -e "HEAD:$f" 2>/dev/null || exit 0
version() { git show "$1:$f" | sed -n 's/^version:[^0-9]*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*+[0-9][0-9]*\).*/\1/p' | head -n 1; }
v=$(version HEAD)
[ -n "$v" ] || exit 0

name=${v%+*}
xy=${name%.*} z=${name##*.}
last=$(git tag -l "v$xy.*" --sort=-v:refname | grep -x "v$xy\.[0-9][0-9]*" | head -n 1) || true
if [ -z "$last" ] || [ "$z" -eq $((${last##*.} + 1)) ]; then
  git tag -a "v$name" -m "Jeansh $name, build ${v#*+}" HEAD
  echo "--> tagged v$name"
elif [ "$z" -gt "${last##*.}" ]; then
  echo "post-commit: not tagging v$name, which skips past $last; the next app commit names it again" >&2
fi

git cat-file -e ":$f" 2>/dev/null || exit 0
build() { git show "$1:$f" | sed -n 's/^version:[^+]*+\([0-9][0-9]*\).*/\1/p' | head -n 1; }
[ "$(build '')" != "${v#*+}" ] || exit 0
blob=$(git show ":$f" | sed "s/^\(version:[^0-9]*\)[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*+[0-9][0-9]*/\1$v/" | git hash-object -w --stdin)
git update-index --cacheinfo "100644,$blob,$f"
