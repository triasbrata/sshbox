#!/bin/sh
# Bumps the build number N on pubspec.yaml's version line, X.Y.Z+N, in every
# commit that changes the app: lib/, android/, ios/, macos/, linux/, windows/,
# assets/, third_party/, pubspec.lock, or pubspec.yaml beyond its version line.
# Docs, tests, tool/ or CLAUDE.md alone leave it as it is. N is the build
# number after "+" (Android versionCode, iOS CFBundleVersion), and every build
# a store takes needs a new one.
#
# X.Y.Z is the version name users see, semver rather than a copy of N:
# - Z, the patch, is the newest vX.Y.Z tag's, and goes up by one once N is 10
#   past the build that tag was made at, so 1.0.6 becomes 1.0.7 on its tenth
#   build; the line's own Z is not trusted, so a merge that brings back an old
#   1.0.N+N line is put right;
# - X.Y is changed by hand, with Z back to 0 (1.0.7+80 becomes 1.1.0+80), and an
#   X.Y with no tag yet is kept as written.
# .githooks/post-commit tags the commit that first has each name.
# ponytail: tags are read from every branch, so a patch one branch reaches
# names the others' builds too, and a tag made on a branch later dropped still
# counts here though it is never pushed; delete it if that ever matters.
#
# N comes from the index, not the working copy: the index is what this commit
# records, and the working copy may hold unstaged pubspec.yaml edits that must
# not ride along, as `git add pubspec.yaml` would make them. So the new line
# goes into the index directly, and into the working copy, whose other edits
# stay unstaged.
#
# A merge that conflicted is committed through here and bumps again.
# ponytail: a merge git commits by itself skips this hook (and a
# pre-merge-commit hook's index changes miss its tree), so two branches that
# each bumped to the same N merge into a second build N. The next app commit
# moves past it; Play refuses the repeat loudly if it is ever uploaded.
#
# On for a clone with: git config core.hooksPath .githooks
set -eu

f=pubspec.yaml
git cat-file -e ":$f" 2>/dev/null || exit 0

if ! git diff --cached --name-only |
    grep -qE '^(lib|android|ios|macos|linux|windows|assets|third_party)/|^pubspec\.lock$' &&
  ! git diff --cached -U0 -- "$f" |
    awk '/^@@/ { h = 1; next } h && /^[-+]/ && !/^[-+]version:/ { y = 1 } END { exit !y }'; then
  exit 0
fi

semver='\([0-9][0-9]*\.[0-9][0-9]*\)\.\([0-9][0-9]*\)+\([0-9][0-9]*\)'
v=$(git show ":$f" | sed -n "s/^version:[^0-9]*$semver.*/\1 \2 \3/p" | head -n 1)
[ -n "$v" ] || { echo "pre-commit: $f's version line isn't X.Y.Z+N" >&2; exit 1; }
set -- $v
xy=$1 z=$2 n=$(($3 + 1))

last=$(git tag -l "v$xy.*" --sort=-v:refname | grep -x "v$xy\.[0-9][0-9]*" | head -n 1) || true
if [ -n "$last" ]; then
  z=${last##*.}
  t=$(git show "refs/tags/$last:$f" | sed -n 's/^version:[^+]*+\([0-9][0-9]*\).*/\1/p' | head -n 1)
  if [ -n "$t" ] && [ $((n - t)) -ge 10 ]; then z=$((z + 1)); fi
fi

setbuild() { sed "s/^\(version:[^0-9]*\)[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*+[0-9][0-9]*/\1$xy.$z+$n/"; }
blob=$(git show ":$f" | setbuild | git hash-object -w --stdin)
git update-index --cacheinfo "100644,$blob,$f"
setbuild < "$f" > "$f.bump.$$" && mv "$f.bump.$$" "$f"
echo "--> app changed: version is now $xy.$z+$n"
