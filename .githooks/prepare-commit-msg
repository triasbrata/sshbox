#!/bin/sh
# Adds "[build vN]" to a plain or -m/-F commit whose pubspec.yaml version line
# is staged, N being the build number it commits. Merges, squashes, amends
# with -c/-C and templates are left alone. The tag goes above a closing block
# of trailers (Co-Authored-By: …), so they stay trailers, and in a plain
# commit above git's comment lines, so it survives the editor.
# ponytail: emptying the message in the editor no longer aborts the commit,
# since the tag is left; delete the tag line too.
set -eu

msg=$1
case ${2:-} in '') plain=1 ;; message) plain=0 ;; *) exit 0 ;; esac
git diff --cached -U0 -- pubspec.yaml | grep -q '^+version:' || exit 0
n=$(git show :pubspec.yaml | sed -n 's/^version:[^+]*+\([0-9][0-9]*\).*/\1/p' | head -n 1)
[ -n "$n" ] || exit 0

awk -v tag="[build v$n]" -v plain="$plain" '
  { line[NR] = $0 }
  END {
    end = NR
    if (plain) for (i = 1; i <= NR; i++) if (line[i] ~ /^#/) { end = i - 1; break }
    last = end
    while (last > 0 && line[last] ~ /^[ \t]*$/) last--
    s = last
    while (s > 0 && line[s] ~ /^[A-Za-z0-9-]+: /) s--
    if (s > 0 && s < last && line[s] ~ /^[ \t]*$/) {
      for (i = 1; i <= s; i++) print line[i]
      print tag; print ""
      for (i = s + 1; i <= NR; i++) print line[i]
    } else {
      for (i = 1; i <= last; i++) print line[i]
      print ""; if (last == 0) print ""
      print tag
      for (i = last + 1; i <= NR; i++) print line[i]
    }
  }' "$msg" > "$msg.tag.$$"
mv "$msg.tag.$$" "$msg"
